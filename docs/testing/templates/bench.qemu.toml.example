# Copy to configs/bench.qemu.local.toml (gitignored) and fill in values.
# Used with QEMU user networking / port forward to guest SSH.

[shared.ssh]
ssh_id = 1
host = "127.0.0.1"
port = 2222
username = "root"
# key_filename = "C:/path/to/id_rsa"
# password = ""
timeout = 60.0
# Omit driver or set driver = "ssh" for live paramiko (not sim).
