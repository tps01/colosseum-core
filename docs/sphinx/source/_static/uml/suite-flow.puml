@startuml
skinparam shadowing false
skinparam backgroundColor white
skinparam dpi 150

start
:allocate suite container;
if (setup scripts?) then (yes)
  :run setup slots;
  if (fail_fast and failed?) then (yes)
    :skip remaining tests;
  else (no)
    :run test schedule;
  endif
else (no)
  :run test schedule;
endif
:run all teardown slots;
:finalize suite, rename container;
stop
@enduml
