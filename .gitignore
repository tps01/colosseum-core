# Colosseum run artifacts (debug.log, execution.sqlite, plugin files)
outputs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Sphinx docgen + packaging (see scripts/cleanup.py)
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/
pip-log.txt

# Virtual environments
.venv/
venv/
ENV/
env/

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Packaging / installers
*.manifest
*.spec

# Editors and IDEs
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Local secrets and overrides (bench configs may reference keys/passwords)
.env
.env.*
!.env.example

# Optional local bench overrides (keep examples/configs/ tracked)
**/bench.local.toml
**/bench.*.local.toml

# Local notes and agent scratch (normative docs: docs/, examples/)
scratchpad/

# Local historical doc copies (recover from tag in docs/archive/README.md)
docs/archive/*
!docs/archive/README.md
!docs/archive/MANIFEST.md
!docs/archive/planning/
!docs/archive/planning/**

# Offline packaging (see scripts/package_offline.py)
wheelhouse/
offline-bundle/
colosseum-*-offline-*.tar.gz

# Yocto / Poky / QEMU regression (see infra/yocto/README.md)
# BitBake tree + downloads/sstate (local.conf.sample points DL_DIR/SSTATE_DIR here)
infra/yocto/build/
infra/yocto/cache/
# Optional in-repo Poky clone; README recommends cloning outside the repo instead
infra/yocto/poky/
# Local regression outputs only (wic/ext4/img, qemu.pid, *.log); not for CI
infra/yocto/artifacts/**
!infra/yocto/artifacts/.gitkeep
